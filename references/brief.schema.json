{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Director brief v1",
  "type": "object",
  "required": ["version", "mode", "mode_reason"],
  "properties": {
    "version": {"const": 1},
    "mode": {"enum": ["brief", "batch", "delta", "image_feedback", "sequence", "housekeeping"]},
    "mode_reason": {"type": "string", "minLength": 1},
    "aesthetic": {"type": "string", "minLength": 1},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "beats": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "t_start", "t_end", "text", "is_turn"],
      "properties": {"id": {"type": "integer", "minimum": 1}, "t_start": {"type": "number", "minimum": 0},
        "t_end": {"type": "number", "exclusiveMinimum": 0}, "text": {"type": "string", "minLength": 1}, "is_turn": {"type": "boolean"}}
    }},
    "refs": {"type": "array", "minItems": 8, "items": {"type": "object", "required": ["handle", "role", "use", "cited_by", "source"],
      "properties": {"source": {"enum": ["user", "taste", "refstat", "local_lib", "web"]}, "handle": {"type": "string"}, "role": {"type": "string"}, "use": {"type": "string"}, "cited_by": {"type": "array"}}
    }},
    "forks": {"type": "array", "maxItems": 3},
    "assets": {"type": "array"}
  },
  "allOf": [{"if": {"properties": {"mode": {"enum": ["brief", "batch", "sequence"]}}},
    "then": {"required": ["aesthetic", "duration", "beats", "refs", "assets", "forks"]}}]
}
