{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "good_for",
    "avoid_for",
    "pairs_with_sfx",
    "conflicts",
    "style_tags",
    "intent",
    "energy",
    "needs",
    "duration_ms",
    "gate",
    "preview",
    "cost_ms_per_frame@720p"
  ],
  "properties": {
    "good_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "avoid_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pairs_with_sfx": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "intent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "hit",
          "reveal",
          "breathe",
          "build",
          "drop",
          "transition-match",
          "transition-energy",
          "texture",
          "title",
          "conceal",
          "play",
          "distort"
        ]
      }
    },
    "energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "subject",
          "motion",
          "alpha",
          "text"
        ]
      }
    },
    "duration_ms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "axis",
        "status",
        "date",
        "record_path"
      ],
      "properties": {
        "axis": {
          "const": "technical"
        }
      },
      "additionalProperties": true
    },
    "preview": {
      "type": "object",
      "required": [
        "video",
        "thumbnail",
        "duration_ms"
      ],
      "properties": {
        "video": {
          "type": "string",
          "minLength": 1
        },
        "thumbnail": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "cost_ms_per_frame@720p": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "$comment": "Additive legacy registry fields are permitted. Duration min<max is checked by validate_card; JSON Schema cannot compare sibling numbers."
}
